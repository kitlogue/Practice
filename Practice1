import 'package:flutter/material.dart';

void main() {
  runApp(const MaterialApp(
    home: Scaffold(
      body: Center(
        child: NewsTile(
          rank: 1,
          title: "SMR 기술, 에너지 시장의 게임 체인저가 될까?",
        ),
      ),
    ),
  ));
}

// 1. [객체지향] 'NewsTile'이라는 나만의 화면 부품(클래스)을 설계합니다.
class NewsTile extends StatelessWidget {
  // 2. [상태/데이터] 이 부품이 가질 데이터들입니다.
  final int rank;
  final String title;

  // 3. [super.key] 부모(StatelessWidget)에게 신분증을 전달하는 생성자입니다.
  // const를 붙여서 "데이터가 안 변하면 재사용하라"고 알려줍니다.
  const NewsTile({
    super.key, 
    required this.rank, 
    required this.title,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(20), // 변하지 않는 설정에는 const를 붙입니다.
      decoration: BoxDecoration(
        border: Border.all(color: Colors.grey.shade300),
        borderRadius: BorderRadius.circular(10),
      ),
      child: Row(
        children: [
          // 랭킹 표시 부품
          Text("#$rank", style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold)),
          const SizedBox(width: 20),
          // 제목 표시 부품 (글자가 길어지면 줄바꿈되게 Expanded 사용)
          Expanded(
            child: Text(title, style: const TextStyle(fontSize: 16)),
          ),
        ],
      ),
    );
  }
}
